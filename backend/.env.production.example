# =====================================================================
# Server .env for staging / production.
# deploy/remote-release.sh copies this to <APP_DIR>/shared/.env on the
# first deploy and stops so you can fill it in. NEVER commit the real one.
# =====================================================================

APP_NAME="Cavity Care Pro"
APP_ENV=production
# Generate once on the server: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
# Same-domain setup: Laravel mounted at /api on the site → APP_URL=https://example.com/api
# Separate API subdomain (e.g. care-back.example.com)  → APP_URL=https://care-back.example.com
APP_URL=https://example.com/api
# Separate subdomains only: origin of the React app (CORS) — e.g. https://care-pro.example.com
FRONTEND_URL=
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

CLINIC_TIMEZONE=Asia/Damascus

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL database created in cPanel (staging and production use DIFFERENT databases)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Login sessions (Sanctum SPA cookies). Domain without scheme/port:
#   separate subdomains: the APP's host, e.g. care-pro.example.com
#   staging:    staging.example.com
#   production: example.com,www.example.com
SANCTUM_STATEFUL_DOMAINS=example.com
SESSION_DRIVER=database
SESSION_LIFETIME=720
# Separate subdomains: share cookies across them → SESSION_DOMAIN=.example.com
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Backups (php artisan clinic:backup, daily via cron)
MYSQLDUMP_PATH=mysqldump
BACKUP_KEEP_DAYS=14

# Only needed on the machine that runs `php artisan import:supabase`
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=
