# Copy to deploy/targets/staging.env or production.env (both git-ignored).
# SSH key authentication only (ssh-copy-id / cPanel "SSH Access" -> import key).

SSH_HOST=example.com
SSH_PORT=22
SSH_USER=cpaneluser

# Laravel lives OUTSIDE the web root
APP_DIR=/home/cpaneluser/apps/cavity-staging
# Document root of the (sub)domain
WEB_DIR=/home/cpaneluser/staging.example.com
SITE_URL=https://staging.example.com

# PHP 8.3 CLI on the host (cPanel often: /opt/cpanel/ea-php83/root/usr/bin/php)
REMOTE_PHP=php
# e.g. "composer" or "php83 /home/cpaneluser/composer.phar"
REMOTE_COMPOSER=composer

# 1 = put the API in maintenance mode while migrating (use for production)
MAINTENANCE=0

# --- Only when the API has its OWN subdomain (instead of /api under the site) ---
# API_URL=https://care-back.example.com
# BACKEND_WEB_DIR=/home/cpaneluser/domains/care-back.example.com/public_html
